# Copie este archivo como .env y complete los valores. El .env NO se sube a GitHub.

# ---------- Base de datos ----------
DB_URL=jdbc:postgresql://db.tecnoweb.org.bo:5432/db_grupoXXsa
DB_NAME=db_grupoXXsa
DB_USERNAME=grupoXXsa
DB_PASSWORD=

# ---------- Correo (SMTP y POP3) ----------
MAIL_HOST=mail.tecnoweb.org.bo
MAIL_USERNAME=grupoXXsa
MAIL_PASSWORD=
MAIL_FROM=grupoXXsa@tecnoweb.org.bo

# Direccion que actua como administrador inicial
APP_ADMIN_CORREO=

